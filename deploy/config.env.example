# =============================================================================
# Phase 2 - Shared Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values from Terraform outputs
# Run: cd terraform && terraform output
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# -----------------------------------------------------------------------------
# Database Configuration (from Terraform outputs)
# -----------------------------------------------------------------------------
# RDS PostgreSQL endpoint (without port)
RDS_ENDPOINT=your-rds-endpoint.region.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=platform_main
RDS_MASTER_USER=postgres
RDS_MASTER_PASSWORD=your-secure-password

# Service-specific database users (create these after deployment)
USER_MGMT_DB_USER=user_mgmt_svc
USER_MGMT_DB_PASSWORD=user-mgmt-password
CHAT_DB_USER=chat_svc
CHAT_DB_PASSWORD=chat-password
DOCUMENT_DB_USER=document_svc
DOCUMENT_DB_PASSWORD=document-password
QUIZ_DB_USER=quiz_svc
QUIZ_DB_PASSWORD=quiz-password

# -----------------------------------------------------------------------------
# S3 Buckets (from Terraform outputs)
# -----------------------------------------------------------------------------
USER_MGMT_S3_BUCKET=your-project-user-management-storage
DOCUMENT_S3_BUCKET=your-project-document-service-storage
QUIZ_S3_BUCKET=your-project-quiz-service-storage

# -----------------------------------------------------------------------------
# Kafka Configuration (from Terraform outputs)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-private-ip:9092
KAFKA_ZOOKEEPER_CONNECT=kafka-private-ip:2181

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# AI/ML Configuration (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key

# -----------------------------------------------------------------------------
# Service URLs (for inter-service communication)
# -----------------------------------------------------------------------------
USER_MGMT_URL=http://app-node-1:8001
CHAT_URL=http://app-node-1:8000
DOCUMENT_URL=http://app-node-2:8002
QUIZ_URL=http://app-node-2:8003

# -----------------------------------------------------------------------------
# Nginx Gateway (from Terraform outputs)
# -----------------------------------------------------------------------------
NGINX_PUBLIC_IP=your-nginx-public-ip
APP_NODE_1_PRIVATE_IP=your-app-node-1-private-ip
APP_NODE_2_PRIVATE_IP=your-app-node-2-private-ip

# -----------------------------------------------------------------------------
# Docker Registry (ECR)
# -----------------------------------------------------------------------------
ECR_REGISTRY=your-account-id.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

