# Chat Service Environment Variables
# Copy to chat.env and fill in values

# Database
DATABASE_URL=postgresql://chat_svc:password@rds-endpoint:5432/platform_main?options=-csearch_path=chat

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-private-ip:9092

# AI
OPENAI_API_KEY=your-openai-api-key

# Service
SERVICE_NAME=chat
SERVICE_PORT=8000
LOG_LEVEL=INFO

# User Management Service (for JWT validation)
USER_MGMT_URL=http://app-node-1:8001

# CORS
CORS_ORIGINS=http://localhost:3000,http://nginx-public-ip

