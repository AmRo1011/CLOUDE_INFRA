# User Management Service Environment Variables
# Copy to user-mgmt.env and fill in values

# Database
DATABASE_URL=postgresql://user_mgmt_svc:password@rds-endpoint:5432/platform_main?options=-csearch_path=user_mgmt

# S3
S3_BUCKET=user-management-storage
AWS_REGION=us-east-1

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Service
SERVICE_NAME=user-mgmt
SERVICE_PORT=8001
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://nginx-public-ip

