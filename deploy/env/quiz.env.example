# Quiz Service Environment Variables
# Copy to quiz.env and fill in values

# Database
DATABASE_URL=postgresql://quiz_svc:password@rds-endpoint:5432/platform_main?options=-csearch_path=quiz

# S3
S3_BUCKET=quiz-service-storage
AWS_REGION=us-east-1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-private-ip:9092

# AI (for quiz generation)
OPENAI_API_KEY=your-openai-api-key

# Service
SERVICE_NAME=quiz
SERVICE_PORT=8003
LOG_LEVEL=INFO

# User Management Service (for JWT validation)
USER_MGMT_URL=http://app-node-1:8001

# Quiz Settings
DEFAULT_QUESTIONS_PER_QUIZ=10
QUIZ_TIME_LIMIT_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://nginx-public-ip

