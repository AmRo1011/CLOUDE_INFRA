# Document Service Environment Variables
# Copy to document.env and fill in values

# Database
DATABASE_URL=postgresql://document_svc:password@rds-endpoint:5432/platform_main?options=-csearch_path=document

# S3
S3_BUCKET=document-service-storage
AWS_REGION=us-east-1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-private-ip:9092

# Service
SERVICE_NAME=document
SERVICE_PORT=8002
LOG_LEVEL=INFO

# User Management Service (for JWT validation)
USER_MGMT_URL=http://app-node-1:8001

# File Processing
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# CORS
CORS_ORIGINS=http://localhost:3000,http://nginx-public-ip

